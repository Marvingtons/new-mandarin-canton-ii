# ---------------------------------------------------------------------------
# Local `wrangler dev` / `opennextjs-cloudflare preview` variables.
#
#   cp .dev.vars.example .dev.vars     (.dev.vars is gitignored)
#
# This is the Workers equivalent of .env.local. Wrangler loads it and exposes
# every key as a Worker binding, which the adapter then also mirrors onto
# process.env — so the same code reads the same names on both hosts.
#
# In PRODUCTION these split two ways (see docs/DEPLOY_RUNBOOK.md):
#   secrets      -> `wrangler secret put NAME`
#   public config -> the `vars` block in wrangler.jsonc (already committed)
#
# NOTHING SECRET BELONGS IN wrangler.jsonc.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Local dev talks to Postgres directly; in production the HYPERDRIVE binding
# supplies this and DATABASE_URL is not set at all.
DATABASE_URL=

# --- Secrets (production: `wrangler secret put <NAME>`) -------------------
# Signs the phone-verification cookie. No fallback — ordering fails loudly
# without it.  openssl rand -hex 32
OTP_SIGNING_SECRET=

# Shared password for the /kitchen board.
ADMIN_DASH_PASSWORD=

# The print endpoint's only credential; travels in the printer's URL.
#   openssl rand -hex 32
CLOUDPRNT_SECRET=

# REQUIRED. Guards the unprinted-alert sweep. The scheduled() handler in
# custom-worker.ts presents it as a bearer token; the route refuses without it.
CRON_SECRET=

# Twilio — Verify service for OTP, plus outbound SMS for the owner alert.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_FROM=

# Owner's mobile, E.164. Unset = the unprinted-order alert silently no-ops.
OWNER_ALERT_PHONE=

# --- Public config --------------------------------------------------------
# Mirrors the `vars` block in wrangler.jsonc, repeated here so local dev
# behaves like production without editing that file.
TENANT_ID=nmc
RESTAURANT_TIMEZONE=America/Los_Angeles
TENANT_TAX_RATE_BPS=775
ORDER_NUMBER_PREFIX=A
PICKUP_LEAD_MINUTES=20
PICKUP_SLOT_INTERVAL_MINUTES=15
ONLINE_ORDERING_CUTOFF_MINUTES=30
MAX_ORDERS_PER_PHONE_PER_DAY=5
MAX_PICKUP_HOURS=48
TIP_PRESETS=
CLOUDPRNT_BUZZER=off
