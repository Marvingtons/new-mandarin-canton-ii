# ---------------------------------------------------------------------------
# Local `wrangler dev` / `opennextjs-cloudflare preview` variables.
#
#   cp .dev.vars.example .dev.vars     (.dev.vars is gitignored)
#
# This is the Workers equivalent of .env.local. Wrangler loads it and exposes
# every key as a Worker binding, which the adapter then also mirrors onto
# process.env — so the same code reads the same names on both hosts.
#
# In PRODUCTION these split two ways (see docs/DEPLOY_RUNBOOK.md):
#   secrets      -> `wrangler secret put NAME`
#   public config -> the `vars` block in wrangler.jsonc (already committed)
#
# NOTHING SECRET BELONGS IN wrangler.jsonc.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Local dev talks to Postgres directly; in production the HYPERDRIVE binding
# supplies this and DATABASE_URL is not set at all.
DATABASE_URL=

# Overrides the placeholder `localConnectionString` on the HYPERDRIVE binding
# in wrangler.jsonc. Only needed when you want local dev to reach a REAL
# database — the placeholder is enough for `build:cf` to succeed.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# --- Secrets (production: `wrangler secret put <NAME>`) -------------------
# Signs the phone-verification cookie. No fallback — ordering fails loudly
# without it.  openssl rand -hex 32
OTP_SIGNING_SECRET=

# Shared password for the kitchen board. THIS is what protects that screen.
ADMIN_DASH_PASSWORD=

# Where the kitchen board answers: the screen mounts at /<slug>.
#
# NOT A SECRET, and not a credential — it is a URL, so it lives in browser
# history, in a bookmark on a shared tablet, and in whatever a phone syncs to
# the cloud. It is a speed bump that keeps the staff screen out of casual scans
# and out of a pasted referrer. ADMIN_DASH_PASSWORD above is the actual
# security and must never be dropped because this is set.
#
# Unset = "kitchen", which is exactly what the path used to be. A wrong slug
# 404s like any other unknown page, and the value is never printed in
# robots.txt or the sitemap — listing it there would hand it out.
#   Example: orders-x7k2
KITCHEN_ROUTE_SLUG=

# The print endpoint's only credential; travels in the printer's URL.
#   openssl rand -hex 32
CLOUDPRNT_SECRET=

# REQUIRED. Guards the unprinted-alert sweep. The scheduled() handler in
# custom-worker.ts presents it as a bearer token; the route refuses without it.
CRON_SECRET=

# TESTING ONLY — skips the hours/lunch gates so an end-to-end order can be
# placed outside business hours. A request presenting this value in the
# `x-gate-bypass` header skips ONLY the business-hours gate (including the
# 20-minute pre-close cutoff) and the lunch-special window; OTP, price
# recomputation, per-phone caps and idempotency all still apply. Leave UNSET in
# production — unset means no bypass exists at all.  openssl rand -hex 32
ORDER_GATE_BYPASS=

# Twilio — Verify service for OTP, plus outbound SMS for the owner alert.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_FROM=

# Owner's mobile, E.164. Unset = the unprinted-order alert silently no-ops.
OWNER_ALERT_PHONE=

# How long a browser stays "already verified" for a number it has proved, so
# returning customers skip the SMS. Default 90. Set 0 to switch the feature off
# entirely — no cookie is issued, and any already out there is refused. Caches
# VERIFICATION only: the per-phone daily cap and every other limit are counted
# against the number in the database and are unaffected.
VERIFIED_PHONE_TTL_DAYS=90

# --- Public config --------------------------------------------------------
# Mirrors the `vars` block in wrangler.jsonc, repeated here so local dev
# behaves like production without editing that file.
TENANT_ID=nmc
RESTAURANT_TIMEZONE=America/Los_Angeles
TENANT_TAX_RATE_BPS=775
ORDER_NUMBER_PREFIX=A
PICKUP_LEAD_MINUTES=20
PICKUP_SLOT_INTERVAL_MINUTES=15
MAX_ORDERS_PER_PHONE_PER_DAY=5
MAX_PICKUP_HOURS=48
TIP_PRESETS=
CLOUDPRNT_BUZZER=off

# Optional. Pins the printer by MAC/serial; unset accepts any printer.
CLOUDPRNT_PRINTER_MAC=

# --- Print patience -------------------------------------------------------
# How long the server waits on the printer before giving up on a job, and how
# long after giving up it will still believe a confirmation. All optional; the
# defaults below are the built-in ones.
#
# PRINT_OFFER_CAP counts POLLS, not seconds — at this printer's ~3s polling,
# 40 is about two minutes. It was 10 (~30s), which was shorter than one slow
# pass over a tall ticket, so orders were being retired while their paper was
# still coming out.
PRINT_OFFER_CAP=40
# Render failures before an order is condemned. Low on purpose: a render
# failure is usually a bug, not a blip.
PRINT_RENDER_CAP=3
# Seconds after the offer cap retires a job during which its confirmation is
# still honoured as a print. 0 logs late confirmations but never honours them.
LATE_CONFIRMATION_GRACE_SECONDS=300
