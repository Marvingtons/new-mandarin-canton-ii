# ---------------------------------------------------------------------------
# New Mandarin Canton II — environment configuration
#
# Copy to .env.local and fill in the real values. Everything is resolved
# through src/config/tenant.server.ts; a missing REQUIRED value throws a
# clear, named error at the point of use (never a silent undefined).
#
# NEXT_PUBLIC_* is the ONLY prefix that reaches the browser bundle. The
# ecommerce private token must NEVER be given that prefix.
# ---------------------------------------------------------------------------

# Which Clover environment to talk to: "sandbox" | "production"
CLOVER_ENV=sandbox

# --- Clover Ecommerce (payments) -------------------------------------------
# Generate an Ecommerce API token of integration type "Hosted iFrame + API/SDK".
# That yields BOTH a public token (iframe) and a private token (charges).
# A plain "API" type token will NOT work with the iframe.

# Merchant ID (MID). Not strictly secret, but server-resolved for consistency.
CLOVER_MERCHANT_ID=

# Private/secret ecommerce token — server ONLY, used to POST /v1/charges.
# NEVER prefix with NEXT_PUBLIC. NEVER commit a real value.
CLOVER_PRIVATE_TOKEN=

# Public ecommerce token (a.k.a. PAKMS / apiAccessKey) — used by the browser
# iframe tokenizer only. Safe to expose; that is why it is NEXT_PUBLIC.
NEXT_PUBLIC_CLOVER_PUBLIC_TOKEN=

# --- Clover Inventory (menu sync, Step 6) ----------------------------------
# NOTE: the ecommerce private token above CANNOT read v3 inventory. Menu sync
# needs a separate Clover Dashboard API token with the Inventory:Read
# permission. Only required when MENU_SOURCE=clover.
CLOVER_INVENTORY_TOKEN=

# --- Menu source ------------------------------------------------------------
# "seed"   -> src/data/seed-menu.ts (default; works with no Clover creds)
# "clover" -> live Clover inventory (requires CLOVER_INVENTORY_TOKEN + MID)
MENU_SOURCE=seed

# --- Restaurant / tenant ----------------------------------------------------
TENANT_ID=new-mandarin-canton
TENANT_TIMEZONE=America/Los_Angeles

# Sales tax. Provide EITHER basis points (preferred, exact) OR a decimal rate.
# 775 bps = 7.75%. TODO(confirm): verify the Chula Vista rate with the owner.
TENANT_TAX_RATE_BPS=775
# Alternative decimal form, used only if TENANT_TAX_RATE_BPS is unset:
# TAX_RATE=0.0775

ORDER_NUMBER_PREFIX=A
PICKUP_LEAD_MINUTES=20
PICKUP_SLOT_INTERVAL_MINUTES=15
ONLINE_ORDERING_CUTOFF_MINUTES=30

# --- Ops --------------------------------------------------------------------
# Guards POST /api/revalidate-menu against unauthenticated cache busting.
REVALIDATE_SECRET=

# Optional: Supabase-backed menu outage snapshot (Step 6 resilience). The
# order store itself uses a local JSON file and needs none of these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
