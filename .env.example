# ---------------------------------------------------------------------------
# New Mandarin Canton II — environment configuration
#
# Copy to .env.local and fill in the real values. Everything is resolved
# through src/config/tenant.server.ts; a missing REQUIRED value throws a
# clear, named error at the point of use (never a silent undefined).
#
# NEXT_PUBLIC_* is the ONLY prefix that reaches the browser bundle, and there
# are no NEXT_PUBLIC_ values below — nothing in this system needs a credential
# on the client. Payment is taken at the counter; the browser never talks to
# the database, Twilio, or the printer.
# ---------------------------------------------------------------------------

# --- Tenant -----------------------------------------------------------------
# New Mandarin Canton is tenant #1. Every row in the database is scoped by
# this, so a second restaurant is a new env set rather than a code change.
TENANT_ID=nmc

# IANA zone. Drives business dates, pickup slots, and the daily order-number
# reset — an 11pm order must not roll onto tomorrow's ticket run.
RESTAURANT_TIMEZONE=America/Los_Angeles

# Sales tax. Provide EITHER basis points (preferred, exact) OR a decimal rate.
# 775 bps = 7.75%. Nothing is charged online, but this figure prints on the
# kitchen ticket and is what the customer is quoted at the counter.
# TODO(confirm): verify the Chula Vista rate with the owner.
TENANT_TAX_RATE_BPS=775
# Alternative decimal form, used only if TENANT_TAX_RATE_BPS is unset:
# TAX_RATE=0.0775

ORDER_NUMBER_PREFIX=A
PICKUP_LEAD_MINUTES=20
PICKUP_SLOT_INTERVAL_MINUTES=15

# Abuse ceilings. With no card on file, a verified phone number is the only
# cost an abuser pays — these are what cap the damage.
# TODO(confirm): 5 orders/day per number is a guess.
MAX_ORDERS_PER_PHONE_PER_DAY=5
MAX_PICKUP_HOURS=48

# Optional: explicit online-ordering windows as JSON, 24h times, all seven
# days required. When unset, the window is the per-day open + lastOnlineOrder
# in src/data/restaurant.ts — the same values the order gate and every display
# surface read, so the two cannot drift. Setting this deliberately creates a
# second source; that is what makes it an override rather than a default.
# (ONLINE_ORDERING_CUTOFF_MINUTES is gone: the cutoff is per day now, not a
# global offset from closing time.)
# ONLINE_ORDERING_HOURS={"monday":{"open":"11:00","close":"20:30"}, ...}

# Tip presets, e.g. "15,18,20". Empty = tipping disabled, which is correct
# while payment happens at the register.
TIP_PRESETS=

# --- Orders database (REQUIRED) ---------------------------------------------
# Supabase Postgres. Use the POOLED connection string (port 6543, PgBouncer
# transaction mode), NOT the direct 5432 port — serverless functions exhaust
# direct connections.
#   postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Apply src/lib/db/schema.sql once before the first order.
DATABASE_URL=
# Connections per instance. Keep small on serverless. Default 4.
# DATABASE_POOL_MAX=4

# Supabase project references. Currently unused by the app — everything goes
# through DATABASE_URL — but kept for the SQL editor / CLI and for tooling.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio (REQUIRED for ordering) -----------------------------------------
# A verified phone number is what replaces payment as the anti-abuse control,
# so without these the order flow refuses rather than degrades.
# Create a Verify service at console.twilio.com -> Verify -> Services.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Sending number (+1...) OR a Messaging Service SID (MG...). Needed only for
# outbound texts — order-ready notices and the unprinted-order alert. OTP
# works without it; Verify uses its own sender.
TWILIO_MESSAGING_FROM=

# --- Star CloudPRNT printer -------------------------------------------------
# The printer POLLS us, so nothing needs to reach into the restaurant network.
# Configure the printer's server URL as:
#   https://<your-domain>/api/print/<CLOUDPRNT_SECRET>
# Generate a long random value — it is the endpoint's only credential:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLOUDPRNT_SECRET=

# Optional: pin the printer's MAC so a leaked URL alone cannot drain the queue.
# Any separator style is accepted (00:11:62:AA:BB:CC, 001162aabbcc).
CLOUDPRNT_PRINTER_MAC=

# Audible alert mode: off (default) | drawer | buzzer | both
# Sent as a response header on the job fetch — see src/lib/print/cloudprnt.ts.
# Use "drawer" for a buzzer wired into the cash-drawer (DK) port, which is
# this restaurant's setup. Do NOT use "drawer" if a real cash drawer is
# attached, or the till pops on every ticket.
# TODO(confirm): bench-test on the real unit before service.
CLOUDPRNT_BUZZER=off

# --- Staff dashboard --------------------------------------------------------
# Shared password for /kitchen. Unset = the board stays closed.
# Rotate it freely — it no longer signs anything (see OTP_SIGNING_SECRET).
ADMIN_DASH_PASSWORD=

# --- Phone verification (REQUIRED for ordering) -----------------------------
# HMAC key for the phone-verification cookie. Its own secret, never the
# kitchen password: rotating this logs out in-flight verifications, and staff
# passwords change far more often than you want that to happen. No fallback —
# if this is unset, ordering fails loudly rather than signing with something
# else. Generate with:
#   openssl rand -hex 32
OTP_SIGNING_SECRET=

# --- Alerts -----------------------------------------------------------------
# Owner's mobile, E.164. Texted when an order has not printed within 2 minutes.
# This is the highest-value safety net in the system — set it.
OWNER_ALERT_PHONE=

# Guards the Vercel cron endpoint. Vercel sends it as a Bearer token.
# Unset = the endpoint is open (it returns counts only, never order data).
CRON_SECRET=
