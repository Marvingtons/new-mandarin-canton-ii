{
  "name": "new-mandarin-canton-ii",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:app-icons": "tsx scripts/build-app-icons.tsx",
    "build:ticket-font": "tsx scripts/build-ticket-font.ts && npm run build:font-module",
    "ticket:sample": "tsx --conditions=react-server scripts/ticket-sample.ts",
    "verify:orders": "tsx --conditions=react-server scripts/verify-orders.ts",
    "dev:db": "tsx --conditions=react-server scripts/dev-orders-db.ts",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "cf-typegen": "wrangler types",
    "build:font-module": "tsx scripts/emit-font-module.ts",
    "torture:print": "tsx scripts/print-torture.ts",
    "verify:otp": "tsx --conditions=react-server scripts/verify-otp-cookie.ts"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "next": "^16.2.12",
    "opentype.js": "^2.0.0",
    "pg": "^8.22.0",
    "pg-cloudflare": "^1.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/opentype.js": "^1.3.10",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.115.0"
  }
}
